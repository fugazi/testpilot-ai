# TestPilot.AI Environment Variables

# If set to 1, metrics will be persisted to a local .metrics.json file
METRICS_PERSIST=1

# GitHub Copilot SDK usually picks up credentials from the ambient environment (GitHub CLI)
# Add any other specific configuration here if needed in the future.

# --- NVIDIA NIM (BYOK - Bring Your Own Key) ---
# Optional. If NVIDIA_API_KEY is set, the agent routes requests to NVIDIA NIM
# (OpenAI-compatible API) instead of GitHub-hosted Copilot models.
# Requests go through /api/provider-proxy, which strips Copilot-proprietary
# parameters (e.g. "snippy") that NVIDIA rejects, and forwards to NVIDIA_BASE_URL.
# Get a free key (nvapi-...) at https://build.nvidia.com
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Path to the Copilot runtime binary (auto-resolved for npm/pnpm layouts)
# COPILOT_CLI_PATH=
# Max wait time for the agent generation in ms.
# Default 270000; capped at maxDuration - 30s (see src/app/api/agent/route.ts)
# AGENT_TIMEOUT_MS=270000

# --- Rate limiting (/api/agent, in-memory per instance) ---
# Max requests per IP inside the window (default 10)
# RATE_LIMIT_MAX=10
# Window size in ms (default 900000 = 15 min)
# RATE_LIMIT_WINDOW_MS=900000

