# TestPilot.AI Environment Variables

# If set to 1, metrics will be persisted to a local .metrics.json file
METRICS_PERSIST=1

# GitHub Copilot SDK usually picks up credentials from the ambient environment (GitHub CLI)
# Add any other specific configuration here if needed in the future.

# --- NVIDIA NIM (BYOK - Bring Your Own Key) ---
# Optional. If NVIDIA_API_KEY is set, the agent routes requests to NVIDIA NIM
# (OpenAI-compatible API) instead of GitHub-hosted Copilot models.
# Get a free key (nvapi-...) at https://build.nvidia.com
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

